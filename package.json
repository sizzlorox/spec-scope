{
  "name": "spec-scope",
  "version": "1.0.0",
  "description": "Visualize, discuss and resolve Spec Kit / OpenSpec specifications in your browser — auto-generated diagrams, an agent-friendly review loop, and one-file tech docs.",
  "keywords": [
    "spec-kit",
    "openspec",
    "spec-driven-development",
    "mermaid",
    "sequence-diagram",
    "documentation",
    "cli",
    "agents"
  ],
  "license": "MIT",
  "author": "sizzlorox",
  "type": "module",
  "bin": {
    "spec-scope": "bin/spec-scope.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "bin",
    "dist/src",
    "web",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sizzlorox/spec-scope.git"
  },
  "homepage": "https://github.com/sizzlorox/spec-scope#readme",
  "bugs": {
    "url": "https://github.com/sizzlorox/spec-scope/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
